# Feishu credentials (required)
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Optional callback verification settings
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_BOT_OPEN_ID=
FEISHU_GROUP_REQUIRE_MENTION=true
FEISHU_MAX_RETRIES=2
FEISHU_RETRY_BACKOFF_SECONDS=0.5
FEISHU_RECEIVED_IMAGES_DIR=./runtime/feishu-images

# File archive: non-text/image files from Feishu/WeChat are saved here
FILE_ARCHIVE_DIR=/data/file

# Codex backend (local codex CLI)
CODEX_CLI_BIN=codex
CODEX_WORK_DIR=./runtime/codex-workdir
CODEX_GENERATED_IMAGES_DIR=~/.codex/generated_images
CODEX_MODEL=
CODEX_PERMISSION_MODE=full
CODEX_TIMEOUT_SECONDS=30
CODEX_STREAM_READ_LIMIT_BYTES=262144
CODEX_MAX_RETRIES=2
CODEX_RETRY_BACKOFF_SECONDS=1.0
CODEX_CIRCUIT_BREAKER_THRESHOLD=5
CODEX_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# Backend routing (switch via /pi /opencode /codex /claude /qodercli; query via /backend)
ACTIVE_BACKEND=pi
BACKEND_STATE_PATH=./runtime/server/backend.json
# Claude Code CLI (auto = max permission under root; dangerously-skip-permissions is rejected)
CLAUDE_CLI_BIN=claude
CLAUDE_MODEL=
CLAUDE_PERMISSION_MODE=auto
CLAUDE_TIMEOUT_SECONDS=60
# Qoder CLI (Claude Code family; dangerously-skip-permissions works under root)
QODERCLI_CLI_BIN=qodercli
QODERCLI_MODEL=
QODERCLI_PERMISSION_MODE=dangerously-skip-permissions
QODERCLI_TIMEOUT_SECONDS=60
# OpenCode CLI (fallback backend; uses native session continuity, opencode manages context)
OPENCODE_CLI_BIN=opencode
# OpenCode 模型，格式 provider/model-id；留空则用 opencode 内部最近使用的模型
# 可用模型列表： opencode models；列表外的模型需先在 ~/.config/opencode/opencode.jsonc 的 provider.<id>.models 里注册
OPENCODE_MODEL=
OPENCODE_AGENT=
OPENCODE_IDLE_TIMEOUT_SECONDS=120
OPENCODE_SESSION_STORE_PATH=./runtime/server/opencode-sessions.json

# Pi Agent CLI (default backend; `pi --mode json`, one process per turn)
# 绝对路径：bin/run-app 的 PATH 不含 /root/.local/bin
PI_CLI_BIN=/root/.local/bin/pi
# 模型格式 provider/model-id；provider 需先在 ~/.pi/agent/models.json 注册
# 模板：conf/pi/models.json.example；可用模型：PI_OFFLINE=1 pi --list-models
PI_MODEL=
# 百炼（或其他 provider）API Key，models.json 里以 $DASHSCOPE_API_KEY 引用
DASHSCOPE_API_KEY=
# 推理强度 reasoning_effort，经 --thinking 下发；取值 off|minimal|low|medium|high|xhigh|max
# 百炼实际两档：low/medium/high→high，xhigh/max→max；留空则不下发、用服务端默认 high
PI_THINKING=high
# --tools 是 allowlist，留空不传
PI_TOOLS=
PI_OFFLINE=true
PI_APPROVE_PROJECT=true
PI_IDLE_TIMEOUT_SECONDS=120
PI_SESSION_STORE_PATH=./runtime/server/pi-sessions.json

# Optional legacy HTTP fields (unused in CLI mode)
CODEX_API_BASE=https://api.openai.com/v1
CODEX_API_KEY=

# Runtime behavior
MAX_HISTORY_ROUNDS=50
STREAMING_ENABLED=true
FEISHU_MESSAGE_CHUNK_CHARS=1500
WECHAT_WEBHOOK_TOKEN=
WECHAT_MESSAGE_CHUNK_CHARS=1800
WECHAT_SIDECAR_BASE_URL=http://127.0.0.1:8787
# sidecar 等待后端回复的超时(ms)，须大于 agent 最长执行时间，否则长任务会被误报"服务繁忙"
CODEXCLAW_WECHAT_TIMEOUT_MS=600000
# 出站文件推送 POST /push/file（飞书+微信统一入口）
# SERVER_HOST=0.0.0.0，该接口无 token 会直接 503 关闭，不降级为免鉴权
PUSH_API_TOKEN=
# 上限取飞书 im/v1/files 的 30MB 硬限制
PUSH_FILE_MAX_MB=30
DEDUPLICATE_TTL_SECONDS=3600
REMINDER_STORE_PATH=./runtime/server/reminders.json
DAILY_TASK_STORE_PATH=./runtime/server/daily-tasks.json

# Memory (长期记忆)
# MEMORY_CATEGORIES: agent 允许写入的记忆类别，每个类别对应 memory/<类别>.md
# MEMORY_ALWAYS_INJECT: 其中每轮常驻注入上下文的类别，须为 MEMORY_CATEGORIES 子集
MEMORY_ENABLED=true
MEMORY_DIR=./memory
MEMORY_CATEGORIES=basic,health,preference,work,finance,recent
MEMORY_ALWAYS_INJECT=basic,health,recent
MEMORY_MAX_INJECT_CHARS=4000
MEMORY_GIT_AUTO_COMMIT=true
MEMORY_GIT_DIR=./runtime/memory-git
MEMORY_CONTEXT_PATH=./runtime/server/memory-context.md

# Server & logging
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
LOG_LEVEL=INFO
