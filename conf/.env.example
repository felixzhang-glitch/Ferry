# Feishu credentials (required)
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Optional callback verification settings
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_BOT_OPEN_ID=
FEISHU_GROUP_REQUIRE_MENTION=true
FEISHU_MAX_RETRIES=2
FEISHU_RETRY_BACKOFF_SECONDS=0.5
FEISHU_RECEIVED_IMAGES_DIR=./runtime/feishu-images

# File archive: non-text/image files from Feishu/WeChat are saved here
FILE_ARCHIVE_DIR=/data/file

# Pi Agent（唯一后端；可用常驻 SDK worker 消除每条消息的 Node 冷启动）
# CLI 回退模式仍用该命令；bin/run-app 保留 /root/.local/bin
PI_CLI_BIN=pi
# 开启前配置与 pi 匹配的 Node >=22.19 及 SDK dist/index.js 绝对路径。
# 改回 false 并重启即可回退 CLI；原生会话、模型、规则文件不变。
PI_PERSISTENT_ENABLED=false
PI_NODE_BIN=node
PI_SDK_MODULE=
PI_WORKER_POOL_SIZE=2
PI_WORKER_STARTUP_TIMEOUT_SECONDS=30
# 最终 pi cwd，不再自动追加 /pi；历史默认路径用于保持原生会话连续性
# 仅配置旧 CODEX_WORK_DIR 时兼容追加 /pi；新键优先，不迁移或删除用户文件
PI_WORK_DIR=./runtime/codex-workdir/pi
# pi --mode json 会在事件行内回显图片 base64（原图×1.33），发图时单行可达数十 MB；
# 此值为 readline 单行上限，过小会触发 LimitOverrunError 导致发图返回“服务繁忙”。32MB 覆盖约 24MB 原图。
PI_STREAM_READ_LIMIT_BYTES=33554432
PI_MAX_RETRIES=2
PI_RETRY_BACKOFF_SECONDS=1.0
PI_CIRCUIT_BREAKER_THRESHOLD=5
PI_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
# 飞书生成图片发现目录，保留历史默认；旧 CODEX_GENERATED_IMAGES_DIR 仍兼容，新键优先
GENERATED_IMAGES_DIR=~/.codex/generated_images
# 模型格式 provider/model-id；候选模型与元数据在 conf/pi/models.json（服务启动时自动同步到 ~/.pi/agent/models.json）
# 可用模型：PI_OFFLINE=1 pi --list-models
PI_MODEL=
# 百炼（或其他 provider）API Key，models.json 里以 $DASHSCOPE_API_KEY 引用
DASHSCOPE_API_KEY=
# DeepSeek 官方 API Key，models.json 的 deepseek provider 以 $DEEPSEEK_API_KEY 引用
DEEPSEEK_API_KEY=
# 推理强度 reasoning_effort，经 --thinking 下发；取值 off|minimal|low|medium|high|xhigh|max
# 百炼实际两档：low/medium/high→high，xhigh/max→max；留空则不下发、用服务端默认 high
PI_THINKING=high
# --tools 是 allowlist，留空不传
PI_TOOLS=
PI_OFFLINE=true
PI_APPROVE_PROJECT=true
# 每次 CLI 尝试的总时限（包含退出等待）。180s ≈ deepseek-flash 实测 p90(25s) 的 7 倍，
# 再宽只是让失败轮次白等更久（历史上出现过跑满 300s 才报超时的轮次）
PI_TIMEOUT_SECONDS=180
# 两次输出之间的最大静默；卡死检测靠它，不要低于最长合法静默工具（实测 90s）
PI_IDLE_TIMEOUT_SECONDS=120
PI_SESSION_STORE_PATH=./runtime/server/pi-sessions.json

# Runtime behavior
STREAMING_ENABLED=true
# 飞书专属：随 pi 生成进度增量更新交互卡片（微信不受影响）。false 恢复整段缓冲后一次性发送
FEISHU_STREAMING_EDIT=true
# 卡片更新节流：两次更新最小间隔(秒) 与 最小新增字数，一起控制 PATCH 频率避免触发飞书限流
FEISHU_STREAM_MIN_INTERVAL_SECONDS=0.7
FEISHU_STREAM_MIN_CHARS=40
FEISHU_MESSAGE_CHUNK_CHARS=1500
WECHAT_WEBHOOK_TOKEN=
WECHAT_MESSAGE_CHUNK_CHARS=1800
WECHAT_SIDECAR_BASE_URL=http://127.0.0.1:8787
# sidecar 等待后端回复的超时(ms)，须大于 agent 最长执行时间，否则长任务会被误报"服务繁忙"
CODEXCLAW_WECHAT_TIMEOUT_MS=600000
# 出站文件推送 POST /push/file（飞书+微信统一入口）
# SERVER_HOST=0.0.0.0，该接口无 token 会直接 503 关闭，不降级为免鉴权
PUSH_API_TOKEN=
# 上限取飞书 im/v1/files 的 30MB 硬限制
PUSH_FILE_MAX_MB=30
DEDUPLICATE_TTL_SECONDS=3600
REMINDER_STORE_PATH=./runtime/server/reminders.json
DAILY_TASK_STORE_PATH=./runtime/server/daily-tasks.json

# Memory (长期记忆)
# MEMORY_CATEGORIES: agent 允许写入的记忆类别，每个类别对应 memory/<类别>.md
# MEMORY_ALWAYS_INJECT: 其中每轮常驻注入上下文的类别，须为 MEMORY_CATEGORIES 子集
MEMORY_ENABLED=true
MEMORY_DIR=./memory
MEMORY_CATEGORIES=basic,health,preference,work,finance,recent
MEMORY_ALWAYS_INJECT=basic,health,recent
MEMORY_MAX_INJECT_CHARS=4000
MEMORY_GIT_AUTO_COMMIT=true
MEMORY_GIT_DIR=./runtime/memory-git
MEMORY_CONTEXT_PATH=./runtime/server/memory-context.md

# Server & logging
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
LOG_LEVEL=INFO
