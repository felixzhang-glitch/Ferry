#!/usr/bin/env bash
# Foreground runner for supervisor: Ferry main service
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

export PATH="/root/.local/bin:/root/.nvm/versions/node/v20.19.4/bin:/root/.pyenv/versions/3.10.13/bin:$PATH"

# Reuse dotenv parsing without invoking service control or changing Python.
# shellcheck disable=SC1091
source "$ROOT_DIR/bin/server"
load_env

# Keep the pi model registry in sync so PI_MODEL in conf/.env is the single
# switch; sync failures warn but never block startup.
sync_pi_models || echo "[WARN] pi models.json 同步失败，继续启动"

exec /root/.pyenv/versions/3.10.13/bin/python -m uvicorn app.main:app \
  --host "${SERVER_HOST:-0.0.0.0}" --port "${SERVER_PORT:-8080}"
