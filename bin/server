#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

CONF_DIR="$ROOT_DIR/conf"
ENV_FILE="$CONF_DIR/.env"
ENV_EXAMPLE_FILE="$CONF_DIR/.env.example"
LOG_DIR="$ROOT_DIR/logs"
RUNTIME_DIR="$ROOT_DIR/runtime/server"
APP_PID_FILE="$RUNTIME_DIR/ferry.pid"
WECHAT_PID_FILE="$RUNTIME_DIR/wechat-sidecar.pid"
OBSERVABILITY_PID_FILE="$RUNTIME_DIR/observability.pid"
APP_LOG_FILE="$LOG_DIR/ferry.log"
WECHAT_LOG_FILE="$LOG_DIR/wechat-sidecar.log"
OBSERVABILITY_LOG_FILE="$LOG_DIR/observability.log"
OBSERVABILITY_ENV_FILE="$CONF_DIR/.env.observability"
PYTHONPATH_DIR="$ROOT_DIR/lib/python"
WECHAT_SIDECAR="$ROOT_DIR/lib/js/wechat-sidecar.mjs"
WECHAT_ACCOUNT_PATH_DEFAULT="$CONF_DIR/wechat/account.json"
WECHAT_SYNC_BUF_PATH_DEFAULT="$ROOT_DIR/runtime/wechat/get_updates_buf.txt"
SUPERVISOR_GROUP="ferry-stack"
SUPERVISOR_OBSERVABILITY="ferry-observability"

usage() {
  cat <<'USAGE'
Usage:
  ./bin/server start [-f|--foreground]   Start Ferry, logged-in WeChat and enabled observability
  ./bin/server stop                      Stop all services
  ./bin/server restart [-f|--foreground] Restart services
  ./bin/server status                    Show service status
  ./bin/server wx login                  Scan QR code to login or refresh WeChat ClawBot
  ./bin/server wx start|stop|restart|status
                                        Manage only WeChat sidecar
  ./bin/server obs start|stop|restart|status
                                        Manage only observability (default port 38080)
  ./bin/server obs credentials [args...]  Run observability credential setup
  ./bin/server obs sync                  Import/sync all configured pi usage history
  ./bin/server help                      Show this help

Tips:
  Supervisor 托管时自动代理 supervisorctl；观测服务是独立 program，不更新 ferry-stack 组
  本地模式全部启动仅自动启动 OBSERVABILITY_ENABLED=true 的观测服务
USAGE
}

ensure_dirs() {
  mkdir -p "$CONF_DIR" "$LOG_DIR" "$RUNTIME_DIR" "$ROOT_DIR/runtime/wechat"
}

ensure_env_file() {
  ensure_dirs
  if [[ ! -f "$ENV_FILE" ]]; then
    if [[ -f "$ENV_EXAMPLE_FILE" ]]; then
      cp "$ENV_EXAMPLE_FILE" "$ENV_FILE"
    else
      touch "$ENV_FILE"
    fi
  fi
}

env_python() {
  if [[ -x "$ROOT_DIR/.venv/bin/python" ]]; then
    printf '%s\n' "$ROOT_DIR/.venv/bin/python"
  else
    printf '%s\n' python3
  fi
}

# Parse dotenv data, never execute it as shell code. The same parser is used by
# both launchers; shell variables (including explicit empty values) take priority.
env_file_values() {
  "$(env_python)" - "$ENV_FILE" "$@" <<'PY'
import re
import sys
from dotenv.main import DotEnv

values = DotEnv(sys.argv[1], encoding="utf-8", override=False).dict()
if len(sys.argv) > 2:
    value = values.get(sys.argv[2])
    sys.stdout.write(value if value is not None else sys.argv[3])
else:
    for key, value in values.items():
        if value is not None and re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key):
            sys.stdout.write(f"{key}\0{value}\0")
PY
}

load_env() {
  ensure_env_file
  local key value env_fd env_pid
  exec {env_fd}< <(env_file_values)
  env_pid=$!
  while IFS= read -r -d '' key && IFS= read -r -d '' value; do
    if [[ ! -v "$key" ]]; then
      export "$key=$value"
    fi
  done <&"$env_fd"
  exec {env_fd}<&-
  wait "$env_pid" || return $?
  export PYTHONPATH="$PYTHONPATH_DIR${PYTHONPATH:+:$PYTHONPATH}"
  export WECHAT_ACCOUNT_PATH="${WECHAT_ACCOUNT_PATH:-$WECHAT_ACCOUNT_PATH_DEFAULT}"
  export WECHAT_SYNC_BUF_PATH="${WECHAT_SYNC_BUF_PATH:-$WECHAT_SYNC_BUF_PATH_DEFAULT}"
}

# Snapshot observability overrides BEFORE load_env imports the main .env. Only
# these keys may come from the separate credential file; never source dotenv.
# Run this in the observability runner/subshell, not in the main app's shell.
load_observability_env() {
  ensure_env_file
  local key value env_fd env_pid
  local -a overrides=()
  exec {env_fd}< <("$(env_python)" - "$OBSERVABILITY_ENV_FILE" <<'PY'
import os
import sys
from dotenv.main import DotEnv

keys = (
    "OBSERVABILITY_ENABLED", "OBSERVABILITY_HOST", "OBSERVABILITY_PORT",
    "OBSERVABILITY_STORE_DIR", "OBSERVABILITY_RETENTION_DAYS",
    "OBSERVABILITY_PASSWORD_HASH", "OBSERVABILITY_READ_TOKEN",
    "OBSERVABILITY_INGEST_TOKEN", "OBSERVABILITY_HMAC_KEY",
    "OBSERVABILITY_COOKIE_SECURE", "OBSERVABILITY_SESSION_TTL_SECONDS",
    "OBSERVABILITY_PI_USAGE_ENABLED", "OBSERVABILITY_PI_SESSION_DIRS",
    "OBSERVABILITY_PI_SCAN_INTERVAL_SECONDS",
)
values = DotEnv(sys.argv[1], encoding="utf-8", override=False).dict()
for key in keys:
    value = os.environ.get(key, values.get(key))
    if value is not None:
        sys.stdout.write(f"{key}\0{value}\0")
PY
  )
  env_pid=$!
  while IFS= read -r -d '' key && IFS= read -r -d '' value; do
    overrides+=("$key=$value")
  done <&"$env_fd"
  exec {env_fd}<&-
  wait "$env_pid" || return $?
  load_env || return $?
  for value in "${overrides[@]}"; do
    export "$value"
  done
}

read_env_from_file() {
  env_file_values "$1" "${2:-}"
}

get_effective_value() {
  local key="$1"
  if [[ -v "$key" ]]; then
    printf '%s' "${!key}"
    return
  fi
  read_env_from_file "$key" "${2:-}"
}

get_pi_work_dir() {
  local work_dir legacy_dir
  legacy_dir="$(get_effective_value CODEX_WORK_DIR ./runtime/codex-workdir)"
  legacy_dir="${legacy_dir:-.}"
  work_dir="$(get_effective_value PI_WORK_DIR "${legacy_dir%/}/pi")"
  "$(env_python)" - "$work_dir" <<'PY'
import os
import sys
print(os.path.abspath(os.path.expanduser(sys.argv[1])))
PY
}

# Sync the versioned pi model registry into the agent dir so `PI_MODEL` in
# conf/.env is the single switch. Byte compare first: identical content stays
# untouched; a change is backed up next to the target before being replaced.
sync_pi_models() {
  local src="$ROOT_DIR/conf/pi/models.json"
  if [[ ! -f "$src" ]]; then
    return 0
  fi
  local agent_dir pi_model
  agent_dir="$(get_effective_value PI_CODING_AGENT_DIR)"
  agent_dir="${agent_dir:-$HOME/.pi/agent}"
  pi_model="$(get_effective_value PI_MODEL)"
  "$(env_python)" - "$src" "$agent_dir" "$pi_model" <<'PY'
import json
import os
import shutil
import sys
import time

src, agent_dir, pi_model = sys.argv[1], os.path.expanduser(sys.argv[2]), sys.argv[3]
with open(src, "rb") as handle:
    data = handle.read()

target = os.path.join(agent_dir, "models.json")
current = None
if os.path.exists(target):
    with open(target, "rb") as handle:
        current = handle.read()

if current != data:
    os.makedirs(agent_dir, exist_ok=True)
    if current is not None:
        shutil.copy2(target, f"{target}.bak.{time.strftime('%Y%m%d-%H%M%S')}")
    with open(target, "wb") as handle:
        handle.write(data)
    print(f"[INFO] pi models.json 已同步: {src} -> {target}")

# Fail soft: pi still transmits unregistered IDs, but with default metadata.
if pi_model:
    provider, _, model_id = pi_model.partition("/")
    try:
        models = json.loads(data)["providers"][provider]["models"]
        registered = {entry.get("id") for entry in models}
    except (KeyError, TypeError, ValueError):
        registered = set()
    if not model_id or model_id not in registered:
        print(
            f"[WARN] PI_MODEL={pi_model} 未在 conf/pi/models.json 注册；pi 将以默认元数据透传该模型",
            file=sys.stderr,
        )
PY
}

ensure_prerequisites() {
  ensure_env_file
  if ! command -v python3 >/dev/null 2>&1; then
    echo "[ERROR] 未找到 python3，请先安装 Python 3.10+"
    exit 1
  fi
  if [[ ! -d .venv ]]; then
    python3 -m venv .venv
  fi

  # shellcheck disable=SC1091
  source .venv/bin/activate
  python -m pip install --upgrade pip >/dev/null
  python -m pip install -r conf/requirements.txt >/dev/null

  local pi_bin work_dir
  pi_bin="$(get_effective_value PI_CLI_BIN)"
  pi_bin="${pi_bin:-pi}"
  if ! command -v "$pi_bin" >/dev/null 2>&1; then
    echo "[ERROR] 未找到 pi CLI，请安装 pi 或设置 PI_CLI_BIN。"
    exit 1
  fi

  work_dir="$(get_pi_work_dir)"
  mkdir -p "$work_dir"
  # Git boundary: keep pi from discovering the parent project's AGENTS.md.
  if [[ ! -e "$work_dir/.git" ]]; then
    git -C "$work_dir" init -q 2>/dev/null || true
  fi
}

# STOPPED/BACKOFF/FATAL also mean managed; supervisorctl status returns nonzero
# for these states. Conversely, an unknown group is not a managed/stopped stack.
is_supervisor_managed() {
  local target="${1:-${SUPERVISOR_GROUP}:*}" output
  command -v supervisorctl >/dev/null 2>&1 || return 1
  output="$(supervisorctl status "$target" 2>/dev/null)" || true
  awk -v target="$target" '
    BEGIN { group = sub(/:\*$/, ":", target); found = 0 }
    $2 ~ /^(STOPPED|STARTING|RUNNING|BACKOFF|STOPPING|EXITED|FATAL|UNKNOWN)$/ {
      if ((group && index($1, target) == 1 && length($1) > length(target)) ||
          (!group && $1 == target)) found = 1
    }
    END { exit !found }
  ' <<< "$output"
}

supervisor_stack_action() {
  local action="$1" result=0
  supervisorctl "$action" "${SUPERVISOR_GROUP}:*" || result=$?
  if is_supervisor_managed "$SUPERVISOR_OBSERVABILITY"; then
    # Deliberately separate from ferry-stack: never reread/update the live group.
    supervisorctl "$action" "$SUPERVISOR_OBSERVABILITY" || result=$?
  else
    echo "[INFO] Supervisor 尚未配置 ${SUPERVISOR_OBSERVABILITY}，跳过观测服务"
  fi
  return "$result"
}

pid_is_running() {
  local pid_file="$1"
  if [[ ! -f "$pid_file" ]]; then
    return 1
  fi
  local pid
  pid="$(cat "$pid_file" 2>/dev/null || true)"
  if [[ -z "$pid" || ! "$pid" =~ ^[0-9]+$ ]]; then
    return 1
  fi
  kill -0 "$pid" 2>/dev/null
}

stop_pid() {
  local name="$1"
  local pid_file="$2"
  if ! pid_is_running "$pid_file"; then
    rm -f "$pid_file"
    echo "[INFO] ${name} 未运行"
    return 0
  fi

  local pid
  pid="$(cat "$pid_file")"
  echo "[INFO] 正在停止 ${name}，PID=$pid"
  kill "$pid" 2>/dev/null || true
  for _ in $(seq 1 20); do
    if ! kill -0 "$pid" 2>/dev/null; then
      rm -f "$pid_file"
      echo "[INFO] ${name} 已停止"
      return 0
    fi
    sleep 0.5
  done
  echo "[WARN] ${name} 普通停止超时，执行强制停止"
  kill -9 "$pid" 2>/dev/null || true
  rm -f "$pid_file"
  echo "[INFO] ${name} 已强制停止"
}

start_app() {
  local foreground="${1:-0}"
  ensure_dirs
  ensure_prerequisites
  load_observability_env
  sync_pi_models || echo "[WARN] pi models.json 同步失败，继续启动"

  if pid_is_running "$APP_PID_FILE"; then
    echo "[INFO] Ferry 已在运行，PID=$(cat "$APP_PID_FILE")"
    return 0
  fi
  rm -f "$APP_PID_FILE"

  local host port
  host="$(get_effective_value SERVER_HOST)"
  port="$(get_effective_value SERVER_PORT)"
  [[ -z "$host" ]] && host="0.0.0.0"
  [[ -z "$port" ]] && port="8080"

  local cmd=(python -m uvicorn app.main:app --host "$host" --port "$port")
  if [[ "$foreground" == "1" ]]; then
    start_wechat_sidecar 0 || true
    echo "[INFO] 前台启动 Ferry: ${cmd[*]}"
    exec "${cmd[@]}"
  fi

  echo "[INFO] 后台启动 Ferry..."
  setsid nohup "${cmd[@]}" >>"$APP_LOG_FILE" 2>&1 < /dev/null &
  local pid=$!
  echo "$pid" > "$APP_PID_FILE"
  sleep 1
  if kill -0 "$pid" 2>/dev/null; then
    echo "[INFO] Ferry 启动成功，PID=$pid"
    echo "[INFO] 日志文件: $APP_LOG_FILE"
  else
    echo "[ERROR] Ferry 启动失败，请检查日志: $APP_LOG_FILE"
    tail -n 50 "$APP_LOG_FILE" 2>/dev/null || true
    rm -f "$APP_PID_FILE"
    exit 1
  fi
}

start_wechat_sidecar() {
  local require_login="${1:-0}"
  ensure_dirs
  load_env
  if ! command -v node >/dev/null 2>&1; then
    echo "[WARN] 未找到 node，跳过 WeChat sidecar"
    return 0
  fi
  if [[ ! -f "$WECHAT_ACCOUNT_PATH" ]]; then
    if [[ "$require_login" == "1" ]]; then
      echo "[ERROR] WeChat 未登录，请先执行 ./bin/server wx login"
      exit 1
    fi
    echo "[INFO] WeChat 未登录，跳过 sidecar；需要时执行 ./bin/server wx login"
    return 0
  fi
  if pid_is_running "$WECHAT_PID_FILE"; then
    echo "[INFO] WeChat sidecar 已在运行，PID=$(cat "$WECHAT_PID_FILE")"
    return 0
  fi
  rm -f "$WECHAT_PID_FILE"
  echo "[INFO] 后台启动 WeChat sidecar..."
  setsid nohup node "$WECHAT_SIDECAR" run >>"$WECHAT_LOG_FILE" 2>&1 < /dev/null &
  local pid=$!
  echo "$pid" > "$WECHAT_PID_FILE"
  sleep 1
  if kill -0 "$pid" 2>/dev/null; then
    echo "[INFO] WeChat sidecar 启动成功，PID=$pid"
    echo "[INFO] 日志文件: $WECHAT_LOG_FILE"
  else
    echo "[ERROR] WeChat sidecar 启动失败，请检查日志: $WECHAT_LOG_FILE"
    tail -n 50 "$WECHAT_LOG_FILE" 2>/dev/null || true
    rm -f "$WECHAT_PID_FILE"
    exit 1
  fi
}

# Keep dotenv imports out of the main service's environment.
start_observability() (
  local optional="${1:-0}"
  ensure_dirs
  if pid_is_running "$OBSERVABILITY_PID_FILE"; then
    echo "[INFO] Observability 已在运行，PID=$(cat "$OBSERVABILITY_PID_FILE")"
    return 0
  fi
  rm -f "$OBSERVABILITY_PID_FILE"
  load_observability_env || return $?
  if [[ "$optional" == "1" ]]; then
    case "${OBSERVABILITY_ENABLED:-false}" in
      true|True|TRUE|1|yes|Yes|YES|on|On|ON) ;;
      *) echo "[INFO] Observability 未启用，跳过自动启动"; return 0 ;;
    esac
  fi
  echo "[INFO] 后台启动 Observability..."
  setsid nohup "$ROOT_DIR/bin/run-observability" >>"$OBSERVABILITY_LOG_FILE" 2>&1 < /dev/null &
  local pid=$!
  echo "$pid" > "$OBSERVABILITY_PID_FILE"
  sleep 1
  if kill -0 "$pid" 2>/dev/null; then
    echo "[INFO] Observability 启动成功，PID=$pid"
    echo "[INFO] 日志文件: $OBSERVABILITY_LOG_FILE"
  else
    # Never print configuration or log contents, which may contain credentials.
    echo "[ERROR] Observability 启动失败，请检查日志: $OBSERVABILITY_LOG_FILE"
    rm -f "$OBSERVABILITY_PID_FILE"
    return 1
  fi
)

observability_action() {
  local action="$1" optional="${2:-0}"
  if is_supervisor_managed "$SUPERVISOR_OBSERVABILITY"; then
    supervisorctl "$action" "$SUPERVISOR_OBSERVABILITY"
    return $?
  fi
  if is_supervisor_managed; then
    echo "[INFO] Supervisor 尚未配置 ${SUPERVISOR_OBSERVABILITY}，不会启动本地副本"
    [[ "$optional" == "1" ]]
    return $?
  fi
  case "$action" in
    start) start_observability "$optional" ;;
    stop) stop_pid "Observability" "$OBSERVABILITY_PID_FILE" ;;
    restart)
      stop_pid "Observability" "$OBSERVABILITY_PID_FILE"
      start_observability "$optional"
      ;;
    status) status_one "Observability" "$OBSERVABILITY_PID_FILE" "$OBSERVABILITY_LOG_FILE" ;;
  esac
}

observability_credentials() {
  # The Python CLI reads both dotenv files itself. Do not import .env defaults
  # into its environment or create credential/configuration files in this wrapper.
  PYTHONPATH="$PYTHONPATH_DIR${PYTHONPATH:+:$PYTHONPATH}" \
    "$(env_python)" -m observability.credentials "$@"
}

status_one() {
  local name="$1"
  local pid_file="$2"
  local log_file="$3"
  if pid_is_running "$pid_file"; then
    echo "[INFO] ${name} 运行中，PID=$(cat "$pid_file")"
    echo "[INFO] ${name} 日志: $log_file"
  else
    rm -f "$pid_file"
    echo "[INFO] ${name} 未运行"
  fi
}

wechat_login() {
  ensure_dirs
  load_env
  if ! command -v node >/dev/null 2>&1; then
    echo "[ERROR] 未找到 node，无法执行微信登录"
    exit 1
  fi
  node "$WECHAT_SIDECAR" login
}

main() {
  local cmd="${1:-start}"
  case "$cmd" in
    start|restart)
      if is_supervisor_managed; then
        supervisor_stack_action "$cmd"
        return $?
      fi
      shift || true
      local foreground=0 obs_result=0
      if [[ "${1:-}" == "-f" || "${1:-}" == "--foreground" ]]; then
        foreground=1
      fi
      if [[ "$cmd" == "restart" ]]; then
        stop_pid "WeChat sidecar" "$WECHAT_PID_FILE"
        stop_pid "Ferry" "$APP_PID_FILE"
      fi
      # Resolve observability before start_app imports .env into this shell;
      # otherwise those defaults would shadow .env.observability in the child.
      # An optional service failure must not prevent the existing stack starting.
      observability_action "$cmd" 1 || obs_result=$?
      start_app "$foreground"
      if [[ "$foreground" != "1" ]]; then
        start_wechat_sidecar 0 || true
      fi
      return "$obs_result"
      ;;
    stop)
      if is_supervisor_managed; then
        supervisor_stack_action stop
        return $?
      fi
      stop_pid "WeChat sidecar" "$WECHAT_PID_FILE"
      stop_pid "Ferry" "$APP_PID_FILE"
      observability_action stop 1
      ;;
    status)
      if is_supervisor_managed; then
        supervisor_stack_action status
        return $?
      fi
      status_one "Ferry" "$APP_PID_FILE" "$APP_LOG_FILE"
      status_one "WeChat sidecar" "$WECHAT_PID_FILE" "$WECHAT_LOG_FILE"
      observability_action status 1
      ;;
    wx)
      local subcmd="${2:-status}"
      case "$subcmd" in
        login)
          wechat_login
          ;;
        start|stop|restart|status)
          if is_supervisor_managed; then
            supervisorctl "$subcmd" "${SUPERVISOR_GROUP}:wechat-sidecar"
            return $?
          fi
          case "$subcmd" in
            start) start_wechat_sidecar 1 ;;
            stop) stop_pid "WeChat sidecar" "$WECHAT_PID_FILE" ;;
            restart)
              stop_pid "WeChat sidecar" "$WECHAT_PID_FILE"
              start_wechat_sidecar 1
              ;;
            status) status_one "WeChat sidecar" "$WECHAT_PID_FILE" "$WECHAT_LOG_FILE" ;;
          esac
          ;;
        *)
          echo "[ERROR] 未知 wx 命令: $subcmd"
          usage
          exit 1
          ;;
      esac
      ;;
    obs)
      local subcmd="${2:-status}"
      case "$subcmd" in
        start|stop|restart|status) observability_action "$subcmd" ;;
        sync)
          PYTHONPATH="$PYTHONPATH_DIR${PYTHONPATH:+:$PYTHONPATH}" "$(env_python)" -m observability.usage_cli sync
          ;;
        credentials)
          shift 2
          observability_credentials "$@"
          ;;
        *)
          echo "[ERROR] 未知 obs 命令: $subcmd"
          usage
          return 1
          ;;
      esac
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      echo "[ERROR] 未知命令: $cmd"
      usage
      exit 1
      ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
